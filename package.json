{
  "name": "devworld-pc",
  "productName": "Dev World PC",
  "version": "1.0.0",
  "description": "Dev World PC Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "firebase": "8.10.0"
  },
  "devDependencies": {
    "electron": "28.0.0",
    "electron-builder": "24.9.0"
  },
  "build": {
    "appId": "com.thatonedev.devworldpc",
    "productName": "Dev World PC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "res/images/launcher.png",
      "uninstallerIcon": "res/images/launcher.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
