{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Dev World",
  "version": "0.1.0",
  "identifier": "dev.devworlddevelopers.devworldlauncher",
  "build": {
    "frontendDist": "../res/main"
  },
  "app": {
    "windows": [
      {
        "title": "Dev World - make and play",
        "width": 900,
        "height": 550,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../required/assets/creditable/logos/devworlddevelopers/devworldlauncherlogo.png"
    ]
  }
}
